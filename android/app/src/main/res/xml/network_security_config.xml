<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext anywhere. Dropper's own TLS pins the PC key and does not use these anchors. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
